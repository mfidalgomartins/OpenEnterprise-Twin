# Copy this file to .env, keep .env out of version control and set mode 0600.
# PostgreSQL is the only supported relational store outside isolated tests.
# Generate a local password with: openssl rand -hex 32
# Keep POSTGRES_PASSWORD and the password segment in the URL identical.
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
OPENENTERPRISE_TWIN_DATABASE_URL=postgresql+psycopg://openenterprise_twin:replace-with-a-long-random-local-password@127.0.0.1:5432/openenterprise_twin
OPENENTERPRISE_TWIN_DATABASE_POOL_SIZE=5
OPENENTERPRISE_TWIN_DATABASE_MAX_OVERFLOW=10
OPENENTERPRISE_TWIN_DATABASE_POOL_TIMEOUT_SECONDS=30
OPENENTERPRISE_TWIN_DATABASE_POOL_RECYCLE_SECONDS=1800

# Content-addressed simulation artifacts are generated locally and ignored by
# git. The v0.5 adapter and worker are single-node; do not start multiple API
# processes against independent artifact directories.
OPENENTERPRISE_TWIN_ARTIFACT_DIRECTORY=artifacts
OPENENTERPRISE_TWIN_EXPERIMENT_WORKERS=2
OPENENTERPRISE_TWIN_REPLICATION_WORKERS_PER_EXPERIMENT=4
# Keep the service-manager termination grace period above this value.
OPENENTERPRISE_TWIN_EXPERIMENT_SHUTDOWN_TIMEOUT_SECONDS=5

# Development may call the API directly from Vite. Production should use the
# supplied same-origin Nginx proxy and normally leave CORS empty.
OPENENTERPRISE_TWIN_CORS_ALLOWED_ORIGINS=["http://127.0.0.1:5173"]
OPENENTERPRISE_TWIN_DEPLOYMENT_ENVIRONMENT=development
OPENENTERPRISE_TWIN_TRUSTED_HOSTS=["localhost","127.0.0.1"]
OPENENTERPRISE_TWIN_MAX_REQUEST_BODY_BYTES=1048576
OPENENTERPRISE_TWIN_MAX_EXPERIMENT_PERIODS=50000
OPENENTERPRISE_TWIN_MAX_DATASET_OBSERVATIONS=30000
OPENENTERPRISE_TWIN_MAX_OPTIMIZATION_EVALUATIONS=400
OPENENTERPRISE_TWIN_MAX_OPTIMIZATION_PERIODS=1000000
OPENENTERPRISE_TWIN_MAX_ADAPTIVE_PERIODS=150000

# Required in production and minimum 32 characters. Generate a distinct value
# with `openssl rand -hex 32`, store it in a secret manager and keep it
# server-side; the supplied Nginx proxy injects it into same-origin API requests.
# Leave this variable unset for unauthenticated local development.
# OPENENTERPRISE_TWIN_API_KEY=replace-with-a-distinct-64-character-random-secret

# Optional safe release provenance. If set, use only a 7-64 character lowercase
# hexadecimal Git object ID. Empty or URL-like values are invalid, so leave this
# line commented when no build commit is available.
# OPENENTERPRISE_TWIN_BUILD_COMMIT=0123456789abcdef0123456789abcdef01234567

# Local developer surfaces used by Makefile targets.
DEV_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173
E2E_API_PORT=18000
VITE_API_BASE_URL=http://127.0.0.1:8000

# Reproducible flagship demo defaults.
DEMO_SEED=731
DEMO_REPLICATIONS=100
DEMO_TIMEOUT_SECONDS=600
